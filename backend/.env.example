# FLUMENX OS Backend Production Environment Variables Template

PORT=8000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/flumenx_portal

# JWT Authentication Secrets (Generate 64+ char random strings)
JWT_SECRET=flumenx_super_secret_jwt_auth_key_2026
JWT_REFRESH_SECRET=flumenx_super_secret_refresh_token_key_2026
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token

# CORS and Domain Settings
CORS_ALLOWED_ORIGINS=https://erp.flumenx.in,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=https://erp.flumenx.in

# Hostinger SMTP Mail Configuration (Optional for Leave & System Emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hr@flumenx.in
SMTP_PASS=your_email_password_here
SMTP_FROM="FLUMENX OS <hr@flumenx.in>"
