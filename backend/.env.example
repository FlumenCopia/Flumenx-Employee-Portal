EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-brevo-smtp-login
EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FLUMENX Security <verified-sender@example.com>
FRONTEND_URL=https://replace-with-frontend-domain.com
PASSWORD_RESET_TIMEOUT=3600
