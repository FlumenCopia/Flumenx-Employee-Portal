# ==========================================
# Flumenx Employee Portal - Environment Configuration
# ==========================================

# ------------------------------------------
# Django Security & Debug Configuration
# ------------------------------------------
# Secret key for cryptographic signing. Generate a strong 50+ character random string in production.
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key

# Set to False in production environment
DJANGO_DEBUG=False

# Comma-separated domain names allowed to serve this app (e.g. portal.flumenx.com)
DJANGO_ALLOWED_HOSTS=replace-with-your-domain.com,127.0.0.1

# Comma-separated list of origins allowed for CORS requests (e.g. https://portal.flumenx.com)
CORS_ALLOWED_ORIGINS=https://replace-with-your-domain.com

# Comma-separated list of trusted origins for CSRF protection (e.g. https://portal.flumenx.com)
CSRF_TRUSTED_ORIGINS=https://replace-with-your-domain.com

# ------------------------------------------
# Cookie & CSRF Security (Set True over HTTPS)
# ------------------------------------------
# Enable secure HTTP-only cookies over HTTPS in production
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
JWT_ACCESS_COOKIE_NAME=flumenx_access
JWT_REFRESH_COOKIE_NAME=flumenx_refresh

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Set to 'mysql' for production deployment or 'sqlite' for local development
DB_ENGINE=mysql
MYSQL_DATABASE=flumenx_portal
MYSQL_USER=flumenx_app
MYSQL_PASSWORD=replace-with-a-strong-production-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ------------------------------------------
# Frontend API URL Configuration
# ------------------------------------------
# API URL used by Next.js frontend (frontend/lib/api.ts)
NEXT_PUBLIC_API_URL=https://replace-with-your-domain.com/api
