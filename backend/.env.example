# FLUMENX Backend Production Environment Variables Template
PORT=8000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/flumenx_portal
JWT_SECRET=change-this-to-a-secure-random-64-character-secret
JWT_REFRESH_SECRET=change-this-to-another-secure-random-64-character-secret
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE
FRONTEND_URL=https://YOUR_DOMAIN_HERE

# Hostinger Webmail SMTP Configuration (smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hr@YOUR_DOMAIN_HERE
SMTP_PASS=your-hostinger-webmail-password
SMTP_FROM="FLUMENX HR Portal <hr@YOUR_DOMAIN_HERE>"
